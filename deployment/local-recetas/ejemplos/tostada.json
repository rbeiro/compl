  "steps": [
    {
      "number": 1,
      "action": "Tostar 1 rebanada de pan pochon por ambos lados. Mientras tanto, laminar 45 g de aguacate y sopletear ligeramente su superficie.",
      "observation": "Tostado uniforme; evitar quemar el pan y el aguacate.",
      "source_refs": [
        "1Tp6r-KLkJ0r5Nf4GgOQE_ityrlblbBgk"
      ]
    },
    {
      "number": 2,
      "action": "Centrar la tostada en el plato plano blanco. Untar una capa de hummus sobre el pan y disponer encima el aguacate laminado braseado. Pincelar con 2 g de aceite verde y repartir 2 g de sal maldon.",
      "observation": "Extender el hummus de forma uniforme y mantener las láminas de aguacate ordenadas.",
      "source_refs": [
        "1Tp6r-KLkJ0r5Nf4GgOQE_ityrlblbBgk"
      ]
    },
    {
      "number": 3,
      "action": "Distribuir 3 tomates cherry confitados sobre el aguacate. Decorar con 5 flores, 2 brotes de guisante y 3 g de almendra laminada tostada, siguiendo la ilustración.",
      "observation": "Reparto equilibrado, sin ocultar el aguacate; brotes y flores frescos.",
      "source_refs": [
        "1Tp6r-KLkJ0r5Nf4GgOQE_ityrlblbBgk"
      ]
    },
    {
      "number": 4,
      "action": "Revisar el emplatado y cubrir el plato con la campana de servicio de Oleos para el traslado.",
      "observation": "Borde limpio; campana sin tocar la decoración.",
      "source_refs": [
        "1Tp6r-KLkJ0r5Nf4GgOQE_ityrlblbBgk"
      ]
    }
  ],
  "service_info": {
    "es": "Tostada vegetariana de pan pochon con hummus, aguacate laminado braseado, tomates cherry confitados y almendra laminada tostada. Terminada con aceite verde, brotes de guisante, flores y sal maldon.",
    "en": "Vegetarian pochon toast with hummus, sliced charred avocado, confit cherry tomatoes and toasted flaked almonds. Finished with green oil, pea shoots, edible flowers and Maldon salt."
  },
