    "dish_id",
    "outlet_id",
    "document_type",
    "name_es",
    "name_en",
    "section",
    "ingredients",
    "steps",
    "service_info",
    "portion",
    "pass_minutes",
    "station",
    "dishware",
    "channel_zone",
    "exterior_service",
    "allergens",
    "traces",
    "adaptations",
    "diet",
    "non_allergen_restrictions",
    "metadata",
    "source_refs",
    "provenance",
    "unresolved"
  ],
  "additionalProperties": false
}
