{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Plating Guide recipe record v1.0",
  "description": "Registro normalizado. Validar semántica y autorizaciones fuera del modelo. Las claves son obligatorias; null representa datos desconocidos donde procede.",
