      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "dish_id": {
      "type": "string"
    },
    "outlet_id": {
      "type": "string"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "plating_guide"
      ]
    },
    "name_es": {
      "type": "string"
    },
    "name_en": {
      "type": [
        "string",
        "null"
      ]
    },
    "section": {
      "type": "string"
    },
    "ingredients": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name_es": {
            "type": "string"
          },
          "quantity": {
            "type": [
              "number",
              "null"
            ]
          },
          "unit": {
            "type": "string",
            "enum": [
              "g",
              "kg",
              "ml",
              "l",
              "unidad",
              "porcion",
              "cucharada",
              "cucharadita",
              "al_gusto",
              "desconocida"
            ]
          },
          "original_measure": {
            "type": "string"
          },
          "optional": {
            "type": "boolean"
          },
          "preparation": {
            "type": "string"
          },
          "image_label": {
            "type": "string"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_status": {
            "type": "string",
            "enum": [
              "declarado",
              "verificado",
              "estimado",
              "pendiente"
            ]
          }
        },
        "required": [
          "id",
          "name_es",
          "quantity",
          "unit",
          "original_measure",
          "optional",
          "preparation",
          "image_label",
          "source_refs",
          "evidence_status"
