# Copy to .env.local and fill in.
# Use a separate dev/staging Supabase project. The legacy portal points at the
# production project (dzfwdxhbldnfqowrnhxf), where every edit changes real data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Base URL of apps/api (server-side calls only).
API_URL=http://localhost:8787
