# Copy to .env and fill in. Never commit .env.
# Postgres connection. Supabase: Project Settings > Database > Connection pooling
# (transaction mode, port 6543). Use a dev/staging project, not production.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/compi_dev
# Supabase project URL (tokens are verified against its Auth server).
SUPABASE_URL=https://your-project-ref.supabase.co
# Only for projects still using the legacy shared JWT secret; leave empty otherwise.
SUPABASE_JWT_SECRET=
# Browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:3000
PORT=8787
