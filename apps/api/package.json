{
  "name": "@compi/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/node.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/node.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:local": "tsx test/db/create-db.ts",
    "db:gen": "DATABASE_URL=${DATABASE_URL:-postgres://postgres:postgres@127.0.0.1:5432/compi_dev} pgtyped -c pgtyped.config.json",
    "openapi:export": "tsx scripts/export-openapi.ts && pnpm --filter @compi/api-client generate",
    "dev:auth": "tsx dev/fake-supabase-auth.ts",
    "dev:legacy-backend": "tsx dev/legacy-backend.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1177.0",
    "@hono/node-server": "^2.1.11",
    "@hono/zod-openapi": "^1.6.3",
    "@pgtyped/runtime": "^2.4.2",
    "@scalar/hono-api-reference": "^0.12.24",
    "@supabase/supabase-js": "^2.119.2",
    "@vercel/functions": "^3.11.3",
    "@xmldom/xmldom": "^0.9.12",
    "hono": "^4.13.22",
    "jose": "^6.2.18",
    "jszip": "^3.10.2",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "pngjs": "^7.0.0",
    "resend": "^6.39.0",
    "sax": "^1.6.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@pgtyped/cli": "^2.4.3",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "^6.0.5",
    "@types/sax": "^1.2.7",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
