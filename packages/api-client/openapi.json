{
  "openapi": "3.1.0",
  "info": {
    "title": "CompI API",
    "version": "1.0.0",
    "description": "API for the CompI web and mobile apps. Authenticate with a Supabase Auth access token."
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Supabase Auth access token of the signed-in employee."
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ]
      },
      "SignInResult": {
        "type": "object",
        "properties": {
          "tokens": {
            "$ref": "#/components/schemas/Tokens"
          },
          "next": {
            "$ref": "#/components/schemas/NextStep"
          },
          "codeSent": {
            "type": "boolean",
            "description": "Whether a two-step code was emailed (next = second_factor)."
          }
        },
        "required": [
          "tokens",
          "next",
          "codeSent"
        ]
      },
      "Tokens": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          },
          "expiresAt": {
            "type": "integer",
            "description": "Unix time (s) when the access token expires."
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "expiresAt"
        ]
      },
      "NextStep": {
        "type": "string",
        "enum": [
          "second_factor",
          "password_change",
          "workspace"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "example": "session_expired"
              },
              "message": {
                "type": "string",
                "example": "Sign in again."
              },
              "detail": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "Session": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "aal": {
            "type": [
              "string",
              "null"
            ]
          },
          "needsMfa": {
            "type": "boolean",
            "description": "Rank-1 accounts must verify a second factor before using the workspace."
          },
          "mustChangePassword": {
            "type": "boolean",
            "description": "Signed in with a temporary password; it must be changed first."
          }
        },
        "required": [
          "userId",
          "email",
          "aal",
          "needsMfa",
          "mustChangePassword"
        ]
      },
      "Me": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "hotels": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "hotelKey": {
                  "type": "string",
                  "example": "hotel-arts-barcelona"
                },
                "accessRank": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 3,
                  "description": "1 = executive chef, 2 = editor, 3 = staff."
                }
              },
              "required": [
                "hotelKey",
                "accessRank"
              ]
            }
          }
        },
        "required": [
          "userId",
          "email",
          "hotels"
        ]
      },
      "Outlet": {
        "type": "object",
        "properties": {
          "hotelKey": {
            "type": "string"
          },
          "outletKey": {
            "type": "string"
          },
          "hotel": {
            "type": "string"
          },
          "outlet": {
            "type": "string"
          }
        },
        "required": [
          "hotelKey",
          "outletKey",
          "hotel",
          "outlet"
        ]
      },
      "GuidePage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Guide"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ],
            "description": "Pass as `cursor` to get the next page; null on the last page."
          }
        },
        "required": [
          "items",
          "nextCursor"
        ]
      },
      "Guide": {
        "type": "object",
        "properties": {
          "hotelKey": {
            "type": "string"
          },
          "outletKey": {
            "type": "string"
          },
          "guideKey": {
            "type": "string"
          },
          "hotel": {
            "type": "string"
          },
          "outlet": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "draft",
              "ready",
              "archived"
            ]
          },
          "kind": {
            "type": [
              "string",
              "null"
            ]
          },
          "category": {
            "type": [
              "string",
              "null"
            ]
          },
          "reviewed": {
            "type": "boolean"
          },
          "canClassify": {
            "type": "boolean"
          },
          "hasSource": {
            "type": "boolean"
          },
          "hasImage": {
            "type": "boolean"
          },
          "imageKind": {
            "type": [
              "string",
              "null"
            ]
          },
          "hasCleanImage": {
            "type": "boolean"
          },
          "station": {
            "type": [
              "string",
              "null"
            ],
            "description": "Partida (kitchen station)."
          },
          "portion": {
            "type": [
              "string",
              "null"
            ],
            "description": "Ración."
          },
          "pass": {
            "type": [
              "string",
              "null"
            ],
            "description": "Pase."
          },
          "serviceNotes": {
            "type": [
              "string",
              "null"
            ],
            "description": "Notes for front of house (sala), Spanish."
          },
          "englishName": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "hotelKey",
          "outletKey",
          "guideKey",
          "hotel",
          "outlet",
          "title",
          "state",
          "kind",
          "category",
          "reviewed",
          "canClassify",
          "hasSource",
          "hasImage",
          "imageKind",
          "hasCleanImage",
          "station",
          "portion",
          "pass",
          "serviceNotes",
          "englishName"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/v1/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Liveness",
        "responses": {
          "200": {
            "description": "The API is running.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/v1/health/ready": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Readiness (database reachable)",
        "responses": {
          "200": {
            "description": "Ready.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "Database unreachable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/sign-in": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Sign in with email and password",
        "description": "Returns the session tokens and the next step. When two-step verification is required, a code is emailed.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "maxLength": 254
                  },
                  "password": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "locale": {
                    "type": "string",
                    "enum": [
                      "es",
                      "en",
                      "ca",
                      "it",
                      "pt",
                      "fr",
                      "ar"
                    ],
                    "default": "es",
                    "description": "Language of emails sent."
                  }
                },
                "required": [
                  "email",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignInResult"
                }
              }
            }
          },
          "401": {
            "description": "Wrong email or password.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Too many attempts.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Auth service unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/refresh": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Exchange a refresh token for new tokens",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "refreshToken": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  }
                },
                "required": [
                  "refreshToken"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "New tokens.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Tokens"
                }
              }
            }
          },
          "401": {
            "description": "Session ended.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/sign-out": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "End the current session",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "204": {
            "description": "Signed out."
          },
          "401": {
            "description": "Not signed in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/second-factor": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Email a new two-step code",
        "security": [
          {
            "bearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "locale": {
                    "type": "string",
                    "enum": [
                      "es",
                      "en",
                      "ca",
                      "it",
                      "pt",
                      "fr",
                      "ar"
                    ],
                    "default": "es",
                    "description": "Language of emails sent."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Code sent."
          },
          "401": {
            "description": "Session ended.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "This session does not need verification.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Wait before asking for another code.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/second-factor/verify": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Check a two-step code",
        "security": [
          {
            "bearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "pattern": "^\\d{6}$"
                  }
                },
                "required": [
                  "code"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Result. `invalid`: wrong code; `expired`: ask for a new one; `locked`: too many wrong codes, ask for a new one.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "verified",
                        "invalid",
                        "expired",
                        "locked"
                      ]
                    },
                    "next": {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/NextStep"
                        },
                        {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      ]
                    }
                  },
                  "required": [
                    "status",
                    "next"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Session ended.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/password": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Replace a temporary password",
        "description": "For accounts created with a temporary password. Returns fresh tokens without the pending-change mark.",
        "security": [
          {
            "bearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "password": {
                    "type": "string",
                    "minLength": 10,
                    "maxLength": 128
                  },
                  "locale": {
                    "type": "string",
                    "enum": [
                      "es",
                      "en",
                      "ca",
                      "it",
                      "pt",
                      "fr",
                      "ar"
                    ],
                    "default": "es",
                    "description": "Language of emails sent."
                  }
                },
                "required": [
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password changed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignInResult"
                }
              }
            }
          },
          "401": {
            "description": "Session ended.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Choose another password (10+ characters, different from the temporary one).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/recover": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Set a new password with a personal recovery code",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "maxLength": 254
                  },
                  "code": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "password": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 128
                  }
                },
                "required": [
                  "email",
                  "code",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Password changed; other sessions were ended."
          },
          "403": {
            "description": "Email or code not valid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Choose another password.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Too many attempts.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/invitations/accept": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Accept an invitation and set a password",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "ticket": {
                    "type": "string",
                    "pattern": "^v7_[a-f0-9]{64}$"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 128
                  }
                },
                "required": [
                  "ticket",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Account activated; sign in with the email and new password.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "email": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "email"
                  ]
                }
              }
            }
          },
          "403": {
            "description": "The link is wrong, expired or already used.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Activation already in progress.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Choose another password.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Too many attempts.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/account/recovery-code": {
      "get": {
        "tags": [
          "Account"
        ],
        "summary": "Whether the user has a personal recovery code",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Status.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "configured": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "configured"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Session ended.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Account"
        ],
        "summary": "Create or replace the personal recovery code",
        "description": "The code is returned once and never stored in clear text. Replacing it invalidates the previous one.",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "The new code.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "code"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Session ended.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Sign in again with your password before creating a code.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/session": {
      "get": {
        "tags": [
          "Session"
        ],
        "summary": "Session status",
        "description": "What the client must do before opening the workspace. Works for any valid token, including sessions that still need MFA or a password change.",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Session status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/me": {
      "get": {
        "tags": [
          "Session"
        ],
        "summary": "Current user and hotel access",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "The signed-in employee.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/outlets": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "summary": "Outlets the user can see",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Outlets, ordered by hotel and name.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
