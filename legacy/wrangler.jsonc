{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "compi-web",
  "compatibility_date": "2026-11-21",
  "routes": [{ "pattern": "compichef.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
