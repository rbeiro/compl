  "steps": [
    {
      "number": 1,
      "action": "Laminar 20 g de aguacate y sopletear ligeramente su superficie.",
      "observation": "Láminas regulares; dorado superficial sin quemar el aguacate.",
      "source_refs": [
        "1PuwjprlItPQoJpMDB-tZ4rowc8gdds7k"
      ]
    },
    {
      "number": 2,
      "action": "Disponer 75 g de boniato asado en el centro del plato plano blanco. Colocar el aguacate sobre el boniato, centrado y paralelo a su eje longitudinal.",
      "observation": "Boniato caliente, con el montaje centrado y estable.",
      "source_refs": [
        "1PuwjprlItPQoJpMDB-tZ4rowc8gdds7k"
      ]
    },
    {
      "number": 3,
      "action": "Pincelar el aguacate con 5 g de AOVE y repartir 2 g de sal maldon.",
      "observation": "Brillo uniforme; distribuir la sal de forma equilibrada.",
      "source_refs": [
        "1PuwjprlItPQoJpMDB-tZ4rowc8gdds7k"
      ]
    },
    {
      "number": 4,
      "action": "Finalizar con 3 flores y 2 brotes venecres. Repartir 5 g de vinagreta de arce alrededor del boniato, siguiendo la ilustración, y cubrir con la campana de servicio de Oleos.",
      "observation": "Flores y brotes frescos; borde limpio y campana sin tocar la decoración.",
      "source_refs": [
        "1PuwjprlItPQoJpMDB-tZ4rowc8gdds7k"
      ]
    }
  ],
